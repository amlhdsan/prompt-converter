{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main and quick-convert windows",
  "windows": ["main", "quick"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "http://*:*" }, { "url": "https://*:*" }]
    }
  ]
}
