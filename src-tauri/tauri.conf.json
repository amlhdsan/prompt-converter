{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Converter",
  "mainBinaryName": "prompt-converter",
  "version": "1.2.0",
  "identifier": "com.amlhdsan.promptconverter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "提示词转换器 · Prompt Converter",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Turn rough prompts into structured prompts",
    "longDescription": "提示词转换器：用你自己的 API Key，把随手写的想法变成结构清晰、效果更好的提示词。Global hotkey quick-convert window, tray, clipboard.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": [] } }
  }
}
