{
  "name": "prompt-converter",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "提示词转换器 - turn rough prompts into structured, effective prompts with your own LLM API key",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && python3 tests/e2e.py",
    "mock": "node tests/mock-server.mjs",
    "update": "node scripts/update.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.4",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2"
  }
}
